# Ejecutar backup diario a las 2:00 AM como usuario backupuser
0 2 * * * su-exec backupuser /usr/local/bin/backup.sh >> /var/log/cron.log 2>&1

# Limpiar backups antiguos (más de 7 días) a las 3:00 AM
0 3 * * * su-exec backupuser find /backup -name "portfolio_*.sql.gz" -mtime +7 -delete >> /var/log/cron.log 2>&1